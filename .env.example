# Copy this file to `.env` at the repo root before running `docker compose up`.
# (quickstart.md Prerequisites — the only required setup step besides Docker.)

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=vendor_po

# --- Backend ---
# Replace with a long random value in any shared/real environment.
JWT_SECRET=replace-with-a-long-random-secret
# Orders at or below this amount (in the vendor's currency, major units)
# auto-approve on submission; above it, they require Approver action (FR-007).
APPROVAL_THRESHOLD=5000
