// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// T006: User
// data-model.md: "`email` unique and required; a user MUST hold at least one
// role (enforced via the `UserRole` join table below), and MAY hold more than
// one simultaneously (FR-018, FR-010a)."
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  roles UserRole[]

  createdPurchaseOrders   PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]     @relation("PurchaseOrderApprovedBy")
  rejectedPurchaseOrders  PurchaseOrder[]     @relation("PurchaseOrderRejectedBy")
  cancelledPurchaseOrders PurchaseOrder[]     @relation("PurchaseOrderCancelledBy")
  goodsReceiptEvents      GoodsReceiptEvent[]
  auditLogEntries         AuditLogEntry[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// T007: UserRole
// data-model.md: "A user has zero or more rows here; zero is invalid
// (enforced at the application layer at user-creation time — every user must
// be created with at least one role)."
// ---------------------------------------------------------------------------
enum Role {
  BUYER
  APPROVER
  PROCUREMENT_ADMIN
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// T008: Vendor
// data-model.md: "`name` and `payment_terms` required; no uniqueness
// constraint on `name` (FR-001)."
// ---------------------------------------------------------------------------
model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  paymentTerms String   @map("payment_terms")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// T009: PurchaseOrder
// data-model.md: "A purchase order MUST have at least one line at every point
// in its lifecycle, starting at creation — there is no valid zero-line state,
// not even transiently" (enforced in the service layer, T049/T050 — Prisma
// schema alone cannot express "at least one related row").
// data-model.md: "`approved_by` must not equal `created_by` (FR-010a,
// SC-007)." (enforced in the service layer, T068 — see also the CHECK-based
// reason constraints added by T015, which the schema alone cannot express.)
// data-model.md: "`rejection_reason` required for reject; `cancellation_
// reason` required for cancel, and the two are stored in distinct columns so
// they are never conflated."
// ---------------------------------------------------------------------------
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  orderNumber        String              @unique @map("order_number")
  vendorId           String              @map("vendor_id") @db.Uuid
  status             PurchaseOrderStatus @default(DRAFT)
  total              Decimal             @default(0) @db.Decimal(12, 2)
  createdBy          String              @map("created_by") @db.Uuid
  submittedAt        DateTime?           @map("submitted_at")
  approvedAt         DateTime?           @map("approved_at")
  approvedBy         String?             @map("approved_by") @db.Uuid
  rejectedAt         DateTime?           @map("rejected_at")
  rejectedBy         String?             @map("rejected_by") @db.Uuid
  rejectionReason    String?             @map("rejection_reason")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancelledBy        String?             @map("cancelled_by") @db.Uuid
  cancellationReason String?             @map("cancellation_reason")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  creator   User   @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  approver  User?  @relation("PurchaseOrderApprovedBy", fields: [approvedBy], references: [id])
  rejecter  User?  @relation("PurchaseOrderRejectedBy", fields: [rejectedBy], references: [id])
  canceller User?  @relation("PurchaseOrderCancelledBy", fields: [cancelledBy], references: [id])

  lines PurchaseOrderLine[]

  @@index([vendorId, status])
  @@index([status, submittedAt])
  @@map("purchase_orders")
}

// ---------------------------------------------------------------------------
// T010: PurchaseOrderLine
// data-model.md CHECKs (added at the DB level by T015, not expressible in
// Prisma schema syntax): "CHECK (quantity > 0)", "CHECK (unit_price >= 0)",
// "CHECK (received_qty <= quantity) — enforces the *required* concurrency-
// safe over-receipt rule (FR-014)."
// Note: `outstanding_qty` is NOT a column — "it is always computed as
// `quantity - received_qty` at query/response time" (data-model.md).
// ---------------------------------------------------------------------------
model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  description     String
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  receivedQty     Int      @default(0) @map("received_qty")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrder      PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceiptEvents GoodsReceiptEvent[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// T011: GoodsReceiptEvent
// data-model.md: "`quantity > 0` (rejected otherwise, FR-015); insertion only
// allowed when the parent order's status is `APPROVED`" (the status check is
// enforced in the service layer, T079 — Prisma schema cannot express a check
// against a different table's state).
// ---------------------------------------------------------------------------
model GoodsReceiptEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseOrderLineId String   @map("purchase_order_line_id") @db.Uuid
  quantity            Int
  receivedBy          String   @map("received_by") @db.Uuid
  receivedAt          DateTime @default(now()) @map("received_at")

  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  receiver          User              @relation(fields: [receivedBy], references: [id])

  @@index([purchaseOrderLineId])
  @@map("goods_receipt_events")
}

// ---------------------------------------------------------------------------
// T012: AuditLogEntry
// data-model.md: "required when `actor_type = USER`; MUST be `NULL` when
// `actor_type = SYSTEM`." (structurally enforced by the CHECK constraint
// added by T015, since Prisma schema cannot express a conditional-nullability
// constraint across two columns.)
// Required minimum (FR-019): PO_CREATED, PO_APPROVED, PO_REJECTED,
// PO_CANCELLED, GOODS_RECEIPT_RECORDED. Additional coverage beyond that
// graded minimum: PO_SUBMITTED, VENDOR_CREATED, VENDOR_DEACTIVATED.
// ---------------------------------------------------------------------------
enum AuditActorType {
  USER
  SYSTEM
}

enum AuditAction {
  PO_CREATED
  PO_SUBMITTED
  PO_APPROVED
  PO_REJECTED
  PO_CANCELLED
  GOODS_RECEIPT_RECORDED
  VENDOR_CREATED
  VENDOR_DEACTIVATED
}

enum AuditEntityType {
  PurchaseOrder
  PurchaseOrderLine
  Vendor
}

model AuditLogEntry {
  id          String          @id @default(uuid()) @db.Uuid
  actorType   AuditActorType  @map("actor_type")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id") @db.Uuid
  details     Json
  createdAt   DateTime        @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  // T013: supports "show full history for this order" for dispute resolution
  @@index([entityType, entityId])
  @@map("audit_log_entries")
}
